    "/api/simular/corrida": {
      "post": {
        "tags": [
          "simulación"
        ],
        "summary": "Simular Corrida",
        "description": "Genera ``n`` trabajos y los procesa.\n\nLos que van al canal síncrono se acusan solos; los asíncronos quedan ENVIADO y\nengordan la brecha hasta que alguien los consuma. Con ``incluir_sin_ruta`` se\nañaden trabajos que ninguna regla cubre, para ver el rechazo ruidoso.",
        "operationId": "simular_corrida_api_simular_corrida_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeticionCorrida",
                "default": {
                  "n": 6,
                  "incluir_sin_ruta": false
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorridaSalida"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no es JSON legible en UTF-8.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSalida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simular/corrida-vacia": {
      "post": {
        "tags": [
          "simulación"
        ],
        "summary": "Simular Corrida Vacia",
        "description": "Procesa una lista vacía. Termina SIN_INSUMO, jamás EXITOSA.\n\nEs la patología 3 en un clic: el proceso corrió, no falló nada, y no hizo nada.\nUn tablero binario lo pintaría de verde y el frente se caería durante días.",
        "operationId": "simular_corrida_vacia_api_simular_corrida_vacia_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorridaSalida"
                }
              }
            }
          }
        }
      }
    },
    "/api/simular/consumir": {
      "post": {
        "tags": [
          "simulación"
        ],
        "summary": "Simular Consumo",
        "description": "El receptor asíncrono lee su buzón y de ahí —y sólo de ahí— nace el acuse.\n\nDevuelve cuántas entregas pasaron de ENVIADO a ACUSADO. Ese número es la única\nforma legítima de que la brecha baje: marcarla como resuelta sin que nadie lea\nsería fabricar la evidencia que este proyecto existe para exigir.",
        "operationId": "simular_consumo_api_simular_consumir_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeticionConsumo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaConsumo"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no es JSON legible en UTF-8.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSalida"
                }
              }
            }
          },
          "404": {
            "description": "No hay canal con ese nombre.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSalida"
                }
              }
            }
          },
          "409": {
            "description": "El canal es síncrono: no tiene buzón que consumir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSalida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/simular/vencer": {
      "post": {
        "tags": [
          "simulación"
        ],
        "summary": "Simular Vencimiento",
        "description": "Adelanta el reloj lógico y marca SIN_ACUSE lo que ya venció.\n\nNo espera a que pase el tiempo real: mueve el instante con el que se evalúa el\nplazo. Las entregas dejan de estar «en camino» y pasan a ser un incumplimiento\ncon nombre, canal y antigüedad.\n\nMarcarlas NO reduce la brecha —siguen contando— porque mirar un problema no lo\nresuelve. Sólo un acuse lo hace.",
        "operationId": "simular_vencimiento_api_simular_vencer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PeticionVencimiento"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Datos"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaVencimiento"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no es JSON legible en UTF-8.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorSalida"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reiniciar": {
      "post": {
        "tags": [
          "operación"
        ],
        "summary": "Reiniciar",
        "description": "Vuelve al escenario sembrado: base limpia y buzones vacíos.",
        "operationId": "reiniciar_api_reiniciar_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaReinicio"
                }
              }
            }
          }
        }
      }
    }
  },
