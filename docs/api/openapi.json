          {
            "name": "estado",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/EstadoEntrega"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro por estado.",
              "title": "Estado"
            },
            "description": "Filtro por estado."
          },
          {
            "name": "canal",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro por canal.",
              "title": "Canal"
            },
            "description": "Filtro por canal."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntregaSalida"
                  },
                  "title": "Response Listar Entregas Api Entregas Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/corridas": {
      "get": {
        "tags": [
          "tablero"
        ],
        "summary": "Listar Corridas",
        "description": "Últimas corridas con su desenlace real, SIN_INSUMO incluido.\n\nEs la vista que impide leer «terminó bien» como «hizo algo».",
        "operationId": "listar_corridas_api_corridas_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CorridaSalida"
                  },
                  "title": "Response Listar Corridas Api Corridas Get"
