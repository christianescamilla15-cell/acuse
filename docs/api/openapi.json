        "tags": [
          "tablero"
        ],
        "summary": "Listar Eventos",
        "description": "Bitácora append-only: qué pasó, cuándo y quién lo hizo.\n\nIncluye los hechos que no corresponden a ninguna entrega conocida —un acuse que\ncita una referencia que nadie envió, por ejemplo—. Descartarlos en silencio sería\notro éxito silencioso.",
        "operationId": "listar_eventos_api_eventos_get",
        "parameters": [
          {
            "name": "entrega_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bitácora de una entrega.",
              "title": "Entrega Id"
            },
            "description": "Bitácora de una entrega."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
